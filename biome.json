{
  "$schema": "https://biomejs.dev/schemas/2.5.5/schema.json",
  "files": {
    "ignoreUnknown": true
  },
  "assist": { "actions": { "source": { "organizeImports": "on" } } },
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "defaultBranch": "main",
    "useIgnoreFile": true
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended"
    }
  },
  "formatter": {
    "enabled": true,
    "indentWidth": 2,
    "indentStyle": "space",
    "formatWithErrors": true
  },
  "javascript": { "globals": ["React", "JSX"], "jsxRuntime": "transparent" },
  "json": {
    "parser": {
      "allowComments": true
    }
  },
  "css": {
    "parser": { "cssModules": true },
    "formatter": { "enabled": true },
    "linter": { "enabled": true }
  },
  "overrides": [
    { "includes": ["**/*.{js,jsx,ts,tsx}"], "linter": { "rules": {} } },
    {
      "includes": ["**/*.{ts,tsx}"],
      "linter": {
        "rules": { "correctness": { "noUnusedVariables": "warn" } }
      }
    },
    { "includes": ["**/.eslintrc.cjs", "**/mocks/**/*.js"] },
    { "includes": ["**/.eslintrc.js", "**/mocks/**/*.js"] }
  ]
}
